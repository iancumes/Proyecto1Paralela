// Anexo 1, parte 1 de 2: arranque, argumentos, datos, validacion y banco de pruebas.
digraph PlinkoParte1 {
    rankdir=TB; bgcolor="white"; splines=polyline;
    nodesep=0.30; ranksep=0.36; fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11, margin="0.15,0.10"];
    edge [fontname="Helvetica", fontsize=10, color="#52514e", arrowsize=0.75];
    node [shape=box, style="filled,rounded", fillcolor="#eef4fd", color="#2a78d6"];

    inicio    [shape=oval, fillcolor="#2a78d6", fontcolor="white", label="INICIO\nmain(argc, argv)"];
    fin_ayuda [shape=oval, fillcolor="#1baf7a", fontcolor="white", label="FIN\ncodigo 0"];
    fin_bench [shape=oval, fillcolor="#1baf7a", fontcolor="white", label="FIN\ncodigo 0"];
    node [shape=oval, style=filled, fillcolor="#e34948", fontcolor="white", color="#e34948"];
    fin_e1 [label="FIN\ncodigo 1"]; fin_e2 [label="FIN\ncodigo 1"];
    fin_e3 [label="FIN\ncodigo 1"]; fin_e4 [label="FIN\ncodigo 1"];
    node [shape=box, style="filled,rounded", fillcolor="#eef4fd", color="#2a78d6", fontcolor="black"];
    conector  [shape=circle, fillcolor="#eda100", color="#eda100", fontcolor="black",
               width=0.6, fixedsize=true, label="A"];

    subgraph cluster_argumentos {
        label="1. Captura de argumentos y programacion defensiva";
        fontsize=12; color="#c9d7ea"; style="rounded"; bgcolor="#f7fafe";
        parse   [label="parseCommandLine()\nRecorre argv y reconoce cada opcion:\n-n  --pegs  --modifiers  --bins  --radius  --gravity\n--restitution  --substeps  --no-interaction  --seed\n-w  -h  --no-vsync  -m  -t  --no-prompt\n--benchmark  --bench-*  --screenshot  --warmup"];
        d_valor [shape=diamond, fillcolor="#fdf3e6", color="#eb6834", label="La opcion\nrecibio su valor?"];
        e_valor [shape=parallelogram, fillcolor="#fdecea", color="#e34948", label="Mensaje: la opcion\nrequiere un valor"];
        d_tipo  [shape=diamond, fillcolor="#fdf3e6", color="#eb6834", label="El valor es del\ntipo correcto?"];
        e_tipo  [shape=parallelogram, fillcolor="#fdecea", color="#e34948", label="Mensaje: se esperaba\nun entero o un decimal"];
        d_conoc [shape=diamond, fillcolor="#fdf3e6", color="#eb6834", label="Argumento\nreconocido?"];
        e_conoc [shape=parallelogram, fillcolor="#fdecea", color="#e34948", label="Mensaje: argumento\nno reconocido"];
        d_help  [shape=diamond, fillcolor="#fdf3e6", color="#eb6834", label="Se pidio\n--help ?"];
        s_help  [shape=parallelogram, fillcolor="#eafaf3", color="#1baf7a", label="Imprimir usageText():\nopciones y controles"];
    }

    subgraph cluster_entrada {
        label="2. Solicitud de ingreso de datos";
        fontsize=12; color="#c9d7ea"; style="rounded"; bgcolor="#f7fafe";
        d_n     [shape=diamond, fillcolor="#fdf3e6", color="#eb6834", label="Se indico N\ncon -n ?"];
        d_tty   [shape=diamond, fillcolor="#fdf3e6", color="#eb6834", label="La entrada estandar\nes interactiva?"];
        pedir   [shape=parallelogram, fillcolor="#fff8e6", color="#eda100", label="promptForMissingValues()\nSolicitar N por consola\n(Enter conserva el valor por omision)"];
        d_ok_n  [shape=diamond, fillcolor="#fdf3e6", color="#eb6834", label="N es un entero\nentre 1 y 200000?"];
        reintento [label="Reintentar\n(hasta 3 veces)"];
        omision [label="Usar el valor por\nomision N = 600"];
    }

    subgraph cluster_validacion {
        label="3. Validacion de rangos (validateConfig)";
        fontsize=12; color="#c9d7ea"; style="rounded"; bgcolor="#f7fafe";
        validar [label="Comprobar todos los parametros:\n1 <= N <= 200000\nlienzo >= 640 x 480 pixeles\ngravedad < 0\n0 <= restitucion <= 1\n1 <= sub-pasos <= 16\n0 <= hilos <= 512\nrepeticiones del banco >= 10"];
        d_val   [shape=diamond, fillcolor="#fdf3e6", color="#eb6834", label="Todos los valores\nestan en rango?"];
        e_val   [shape=parallelogram, fillcolor="#fdecea", color="#e34948", label="Imprimir el motivo\ny el texto de ayuda"];
    }

    subgraph cluster_banco {
        label="4. Modo banco de pruebas (no abre ventana)";
        fontsize=12; color="#c9d7ea"; style="rounded"; bgcolor="#f7fafe";
        d_bench [shape=diamond, fillcolor="#fdf3e6", color="#eb6834", label="Se pidio\n--benchmark ?"];
        bench   [label="runBenchmark()\nPara cada N, para cada modo y para cada\ncantidad de hilos: 3 pasos de calentamiento\ny 12 repeticiones cronometradas"];
        bench_calc [label="Calcular promedio, minimo, maximo,\ndesviacion estandar, speedup y eficiencia"];
        bench_out  [shape=parallelogram, fillcolor="#eafaf3", color="#1baf7a", label="Escribir benchmark.csv y\nbenchmark_muestras.csv e\nimprimir la tabla por consola"];
    }

    inicio -> parse;
    parse -> d_valor;
    d_valor -> e_valor [label="no"];  e_valor -> fin_e1;
    d_valor -> d_tipo [label="si"];
    d_tipo -> e_tipo [label="no"];    e_tipo -> fin_e2;
    d_tipo -> d_conoc [label="si"];
    d_conoc -> e_conoc [label="no"];  e_conoc -> fin_e3;
    d_conoc -> d_help [label="si"];
    d_help -> s_help [label="si"];    s_help -> fin_ayuda;
    d_help -> d_n [label="no"];
    d_n -> validar [label="si"];
    d_n -> d_tty [label="no"];
    d_tty -> omision [label="no"];
    d_tty -> pedir [label="si"];
    pedir -> d_ok_n;
    d_ok_n -> validar [label="si"];
    d_ok_n -> reintento [label="no"];
    reintento -> pedir [label="quedan intentos"];
    reintento -> omision [label="se agotaron"];
    omision -> validar;
    validar -> d_val;
    d_val -> e_val [label="no"];      e_val -> fin_e4;
    d_val -> d_bench [label="si"];
    d_bench -> bench [label="si"];
    bench -> bench_calc; bench_calc -> bench_out; bench_out -> fin_bench;
    d_bench -> conector [label="no  (continua en la parte 2)"];
}
